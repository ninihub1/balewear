# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Stripe secret key (Dashboard > Developers > API keys). Starts with sk_test_ or sk_live_.
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret (Dashboard > Developers > Webhooks, or `stripe listen`). Starts with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public URL of the site, no trailing slash. Used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shipping, in cents (AUD). 1000 = $10.00. Set these to the owner's real rates.
SHIPPING_FLAT_RATE_CENTS=1000
FREE_SHIPPING_THRESHOLD_CENTS=15000

# Countries Stripe Checkout will ship to, comma-separated ISO codes.
SHIPPING_COUNTRIES=AU
